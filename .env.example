# Flask
SESSION_SECRET=change-me

# PostgreSQL
DATABASE_URL=postgresql://postgres:root@localhost:5432/attendance_db
# Or use individual vars:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=root
# PGDATABASE=attendance_db

# Optional default SMTP (overridden by Admin → Email Settings in the UI)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# PIN + GPS attendance (server-side only)
# Realistic indoor / campus Wi-Fi accuracy is often 100-200 meters
CLASSROOM_RADIUS_METERS=100
GPS_ACCURACY_BUFFER_METERS=50
GPS_MAX_ACCURACY_METERS=200
SESSION_DEFAULT_MINUTES=15
PIN_PERIOD_SECONDS=45
